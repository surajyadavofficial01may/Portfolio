# ============================================================================
# PORTFOLIO APPLICATION ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY WARNING:
# - Never commit `.env` or real credentials to version control.
# - Replace the placeholder values below with your actual credentials in `.env`
#   or in your deployment platform's Secret Manager / GitHub Actions Secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Core Server Runtime
# ----------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 2. AI Assistant & External RAG Service (/api/v1/chat/ask)
# ----------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
RAG_SERVICE_URL="https://rag-as-service.onrender.com"

# ----------------------------------------------------------------------------
# 3. Supabase Knowledge Base Configuration (Backend / CLI Sync)
#    7 Categories: Personal_Details, Work_Experience, Technical_Skills,
#                  Projects, Articles, Social_Links, FAQs
# ----------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
SUPABASE_SECRET_KEY="your_supabase_secret_key_here"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_KB_BUCKET="portfolio-knowledge-base"
SUPABASE_KB_TABLE="portfolio_knowledge_base"

# ----------------------------------------------------------------------------
# 4. Admin Studio Authentication (Server-Side Only for /admin)
# ----------------------------------------------------------------------------
ADMIN_PASSWORD="your_strong_admin_password_here"

# ----------------------------------------------------------------------------
# 5. Frontend Public Configuration (Vite Client Bundle)
#    WARNING: VITE_* variables are embedded in the public browser bundle.
#    NEVER place SUPABASE_SECRET_KEY or ADMIN_PASSWORD in VITE_* variables.
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
VITE_SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
VITE_SUPABASE_KB_BUCKET="portfolio-knowledge-base"
VITE_SUPABASE_KB_TABLE="portfolio_knowledge_base"
